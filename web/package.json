{
  "name": "web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.6.4",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "gen:commands": "node ./scripts/generate-tauri-commands.mjs",
    "check:commands": "node ./scripts/generate-tauri-commands.mjs --check",
    "gen:bindings": "cargo test -p ta_desktop_demo_app --test specta_bindings_export export_specta_bindings -- --ignored",
    "check:bindings": "node ./scripts/check-specta-bindings.mjs",
    "lint": "eslint . --max-warnings=0 && npm run check:commands && npm run check:bindings && node ./scripts/check-known-tauri-commands.mjs",
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "typecheck:desktop": "tsc --noEmit -p tsconfig.wdio.json",
    "parity": "node ./scripts/check-tauri-parity.mjs",
    "check:tauri-command-risk-policy": "node ./scripts/check-tauri-command-risk-policy.mjs",
    "check:node-reproducibility": "node ../scripts/check_node_reproducibility.mjs",
    "check:manifest-toolchain": "node ../scripts/check_manifest_toolchain_contract.mjs",
    "check:release-secret-hygiene": "node ../scripts/check_release_secret_hygiene.mjs",
    "security:desktop-boundary": "npm run check:commands && npm run parity && npm run check:tauri-capabilities && npm run check:tauri-command-risk-policy",
    "check:qa-actions": "tsx ./scripts/check-action-coverage-manifest.ts",
    "check:qa-selectors": "node ./scripts/check-qa-selector-inventory.mjs",
    "check:artifact-fixtures": "node ./scripts/check-e2e-artifact-fixtures.mjs",
    "check:tauri-capabilities": "node ./scripts/check-tauri-capabilities.mjs",
    "check:qa-static": "npm run check:qa-actions && npm run check:qa-selectors && npm run check:artifact-fixtures && npm run check:tauri-capabilities",
    "qa:summary": "node ./scripts/write-local-qa-summary.mjs",
    "check:qa-report": "npm run check:qa-static && npm run perf:ui:budget && npm run qa:summary",
    "test": "vitest run",
    "analyze:bundle": "vue-tsc -b && vite build --mode analyze",
    "check:bundle-budget": "node ./scripts/check-bundle-budget.mjs",
    "perf:ui:budget": "node ./scripts/check-ui-perf-budget.mjs",
    "qa:dashboard": "node ./scripts/write-frontend-qa-dashboard.mjs",
    "perf:ui:budget:capture": "npm run baseline:ui && npm run perf:ui:budget",
    "bench:request-builder": "vitest run src/services/optimizeRequestBuilder.bench.test.ts",
    "bench:request-builder:compare": "node ./scripts/compare-request-builder-bench.mjs",
    "clean:dist": "node ./scripts/clean-dist.mjs",
    "check:release-dist": "node ./scripts/check-release-dist.mjs",
    "build": "npm run clean:dist && vue-tsc -b && vite build && npm run check:release-dist",
    "preview": "vite preview",
    "a11y:smoke": "npm run build && node ./scripts/check-a11y-smoke.mjs",
    "a11y:smoke:built": "node ./scripts/check-a11y-smoke.mjs",
    "a11y:smoke:managed": "npm run a11y:smoke",
    "a11y:smoke:contrast": "npm run build && npm run a11y:smoke:contrast:built",
    "a11y:smoke:contrast:built": "node ./scripts/check-a11y-smoke.mjs --include-color-contrast",
    "a11y:smoke:wcag": "npm run build && npm run a11y:smoke:wcag:built",
    "a11y:smoke:wcag:built": "node ./scripts/check-a11y-smoke.mjs --include-color-contrast --include-wcag-2-2",
    "baseline:ui": "npm run build && node ./scripts/capture-baseline-ui.mjs",
    "baseline:ui:built": "node ./scripts/capture-baseline-ui.mjs",
    "test:browser:ux": "npm run test:e2e:workflow",
    "test:e2e:workflow": "npm run build && playwright test --project=chromium --grep @workflow",
    "test:e2e:workflow:built": "playwright test --project=chromium --grep @workflow",
    "test:e2e:workflow:core": "npm run build && playwright test e2e/browser/qa/workflowMatrix.spec.ts --project=chromium",
    "test:e2e:workflow:core:built": "playwright test e2e/browser/qa/workflowMatrix.spec.ts --project=chromium",
    "test:e2e:workflow:full": "npm run build && playwright test --project=chromium",
    "test:e2e:workflow:full:built": "playwright test --project=chromium",
    "test:e2e:workflow:headed": "npm run build && playwright test --project=chromium --headed --grep @workflow",
    "test:e2e:workflow:debug": "npm run build && playwright test --project=chromium --debug --grep @workflow",
    "test:e2e:action-coverage": "npm run build && playwright test e2e/browser/qa/actionCoverage.spec.ts --project=chromium",
    "test:e2e:action-coverage:built": "playwright test e2e/browser/qa/actionCoverage.spec.ts --project=chromium",
    "test:e2e:workbench": "npm run build && playwright test e2e/browser/qa/workbenchShell.spec.ts --project=chromium",
    "test:e2e:workbench:built": "playwright test e2e/browser/qa/workbenchShell.spec.ts --project=chromium",
    "test:e2e:responsive": "npm run build && playwright test e2e/browser/qa/responsiveWorkflow.spec.ts e2e/browser/qa/layoutRegression.spec.ts --project=chromium",
    "test:e2e:responsive:built": "playwright test e2e/browser/qa/responsiveWorkflow.spec.ts e2e/browser/qa/layoutRegression.spec.ts --project=chromium",
    "test:e2e:regressions": "npm run build && playwright test e2e/browser/qa/regressionRepros.spec.ts --project=chromium",
    "test:e2e:regressions:built": "playwright test e2e/browser/qa/regressionRepros.spec.ts --project=chromium",
    "test:e2e:visual": "npm run build && playwright test e2e/browser/qa/visualBaselines.spec.ts --project=chromium",
    "test:e2e:visual:built": "playwright test e2e/browser/qa/visualBaselines.spec.ts --project=chromium",
    "test:e2e:visual:update": "npm run build && playwright test e2e/browser/qa/visualBaselines.spec.ts --project=chromium --update-snapshots",
    "test:e2e:visual:update:built": "playwright test e2e/browser/qa/visualBaselines.spec.ts --project=chromium --update-snapshots",
    "test:e2e:explore": "npm run build && playwright test e2e/browser/qa/exploratorySweep.spec.ts --project=chromium",
    "test:e2e:explore:built": "playwright test e2e/browser/qa/exploratorySweep.spec.ts --project=chromium",
    "test:e2e:qa": "npm run build && npm run test:e2e:workbench:built && npm run test:e2e:action-coverage:built && npm run test:e2e:workflow:core:built",
    "test:e2e:qa:built": "npm run test:e2e:workbench:built && npm run test:e2e:action-coverage:built && npm run test:e2e:workflow:core:built",
    "test:desktop:smoke": "wdio run ./wdio.desktop.conf.ts --suite smoke",
    "test:desktop:smoke:debug": "wdio run ./wdio.desktop.conf.ts --suite smoke --logLevel debug",
    "test:desktop:smoke:spec": "wdio run ./wdio.desktop.conf.ts --spec",
    "test:desktop:geometry": "wdio run ./wdio.desktop.conf.ts --suite geometry"
  },
  "dependencies": {
    "@floating-ui/vue": "1.1.10",
    "@pinia/colada": "1.2.0",
    "@tanstack/vue-form": "^1.29.1",
    "@tanstack/vue-table": "^8.21.3",
    "@tanstack/vue-virtual": "3.13.19",
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/plugin-clipboard-manager": "2.3.2",
    "@tauri-apps/plugin-log": "^2.8.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-updater": "2.10.1",
    "@tauri-apps/plugin-window-state": "^2.4.1",
    "@vueuse/core": "14.2.1",
    "@xstate/vue": "^5.0.0",
    "echarts": "^6.0.0",
    "fuse.js": "^7.1.0",
    "lightweight-charts": "5.1.0",
    "lucide-vue-next": "^1.0.0",
    "pinia": "3.0.4",
    "reka-ui": "2.8.2",
    "ts-pattern": "5.9.0",
    "vue": "3.5.28",
    "xstate": "^5.31.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.2",
    "@pinia/testing": "1.0.3",
    "@playwright/test": "1.59.1",
    "@tauri-apps/cli": "2.10.0",
    "@types/mocha": "10.0.10",
    "@types/node": "24.10.1",
    "@typescript-eslint/eslint-plugin": "8.56.0",
    "@typescript-eslint/parser": "8.56.0",
    "@vitejs/plugin-vue": "6.0.4",
    "@vue/test-utils": "2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "@wdio/cli": "9.27.0",
    "@wdio/globals": "9.27.0",
    "@wdio/local-runner": "9.27.0",
    "@wdio/mocha-framework": "9.27.0",
    "@wdio/spec-reporter": "9.27.0",
    "eslint": "10.0.0",
    "eslint-plugin-vue": "10.8.0",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "jsdom": "^28.1.0",
    "mocha": "11.7.5",
    "playwright": "1.59.1",
    "prettier": "3.8.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-checker": "0.12.0",
    "vitest": "4.0.18",
    "vue-tsc": "3.1.5",
    "webdriverio": "9.27.0"
  },
  "overrides": {
    "diff": "8.0.4",
    "serialize-javascript": "7.0.5"
  }
}
