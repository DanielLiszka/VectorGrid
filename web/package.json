{
  "name": "web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.6.4",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "gen:commands": "node ./scripts/generate-tauri-commands.mjs",
    "check:commands": "node ./scripts/generate-tauri-commands.mjs --check",
    "lint": "eslint . --max-warnings=0 && npm run check:commands && node ./scripts/check-known-tauri-commands.mjs",
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "parity": "node ./scripts/check-tauri-parity.mjs",
    "test": "vitest run",
    "analyze:bundle": "vue-tsc -b && vite build --mode analyze",
    "check:bundle-budget": "node ./scripts/check-bundle-budget.mjs",
    "bench:request-builder": "vitest run src/services/optimizeRequestBuilder.bench.test.ts",
    "bench:request-builder:compare": "node ./scripts/compare-request-builder-bench.mjs",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@floating-ui/vue": "1.1.10",
    "@tanstack/vue-table": "^8.21.3",
    "@tanstack/vue-virtual": "3.13.19",
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/plugin-log": "^2.8.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-window-state": "^2.4.1",
    "@vueuse/core": "14.2.1",
    "fuse.js": "^7.1.0",
    "lightweight-charts": "5.1.0",
    "lucide-vue-next": "^1.0.0",
    "pinia": "3.0.4",
    "reka-ui": "2.8.2",
    "vue": "3.5.28",
    "vue-router": "5.0.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.10.0",
    "@types/node": "24.10.1",
    "@typescript-eslint/eslint-plugin": "8.56.0",
    "@typescript-eslint/parser": "8.56.0",
    "@vitejs/plugin-vue": "6.0.4",
    "@vue/test-utils": "2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "10.0.0",
    "eslint-plugin-vue": "10.8.0",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "jsdom": "^28.1.0",
    "prettier": "3.8.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-checker": "0.12.0",
    "vitest": "4.0.18",
    "vue-tsc": "3.1.5"
  }
}
