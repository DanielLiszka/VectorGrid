{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PRISM Experiment Result",
  "type": "object",
  "required": [
    "run_id",
    "algorithm",
    "dataset",
    "strategy_family",
    "budget_ms",
    "wall_clock_ms",
    "hypervolume",
    "archive_size",
    "exact_evals",
    "screened_candidates",
    "false_prune_rate",
    "joint_interval_coverage",
    "partial_reuse_rate",
    "graph_replay_hit_rate",
    "bytes_avoided"
  ],
  "properties": {
    "run_id": {"type": "string"},
    "algorithm": {"type": "string"},
    "dataset": {"type": "string"},
    "strategy_family": {"type": "string"},
    "budget_ms": {"type": "number"},
    "wall_clock_ms": {"type": "number"},
    "hypervolume": {"type": "number"},
    "hv_per_ms": {"type": "number"},
    "archive_size": {"type": "integer"},
    "exact_evals": {"type": "integer"},
    "screened_candidates": {"type": "integer"},
    "screen_pruned": {"type": "integer"},
    "false_prune_rate": {"type": "number"},
    "joint_interval_coverage": {"type": "number"},
    "partial_reuse_rate": {"type": "number"},
    "graph_replay_hit_rate": {"type": "number"},
    "host_device_bytes": {"type": "number"},
    "bytes_avoided": {"type": "number"},
    "cost_model_mape": {"type": "number"},
    "rank_corr_by_stage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stage_name", "spearman_obj0", "spearman_obj1"],
        "properties": {
          "stage_name": {"type": "string"},
          "spearman_obj0": {"type": "number"},
          "spearman_obj1": {"type": "number"}
        }
      }
    }
  }
}
