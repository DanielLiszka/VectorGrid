{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VectorTA Optimizer",
  "version": "0.1.0",
  "identifier": "dev.vectoralpha.vectorta.optimizer",
  "build": {
    "beforeDevCommand": "npm --prefix ./web run dev -- --host 127.0.0.1 --port 1420",
    "beforeBuildCommand": "npm --prefix ./web run build",
    "frontendDist": "../web/dist",
    "devUrl": "http://127.0.0.1:1420"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "VectorTA Optimizer",
        "create": false,
        "width": 1280,
        "height": 720,
        "transparent": true
      }
    ]
  }
}
