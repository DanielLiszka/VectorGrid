{
  "schema_version": 1,
  "timing_boundary": "headless-output-parity",
  "timing_boundary_note": "Deterministic ta_headless_validate report generation for structural JSON/XLSX parity. Supplemental verification only; not a perf gate.",
  "build_profile": "dev",
  "package": "ta_desktop_demo_app",
  "bin": "ta_headless_validate",
  "outputs": {
    "report_json": "_write_test/headless_reports/AAPL_headless_current.json",
    "report_xlsx": "_write_test/headless_reports/AAPL_headless_current.xlsx",
    "parity_manifest": "_write_test/headless_reports/AAPL_headless_current.parity_manifest.json"
  },
  "args": [
    "--csv",
    "data/AAPL.csv",
    "--cross-csv",
    "data/AAPL.csv",
    "--cross-mode",
    "preserved-finalists",
    "--backend",
    "cpu",
    "--fast-ma",
    "sma",
    "--slow-ma",
    "sma",
    "--fast-period",
    "5:20:5",
    "--slow-period",
    "30:60:10",
    "--optimize-top-k",
    "24",
    "--validate-max-candidates",
    "12",
    "--heatmap-bins",
    "24",
    "--xlsx-max-rows",
    "24",
    "--seed",
    "1",
    "--wf-enable",
    "--wf-window-bars",
    "256",
    "--wf-step-bars",
    "64",
    "--perturb-enable",
    "--perturb-iterations",
    "32",
    "--bootstrap-enable",
    "--bootstrap-sims",
    "200",
    "--cscv-enable",
    "--cscv-slices",
    "8",
    "--cscv-max-combinations",
    "2048",
    "--cross-max-datasets",
    "1",
    "--cross-gate-disabled",
    "--cache-dir",
    "_write_test/headless_cache/section19_output_parity"
  ]
}
