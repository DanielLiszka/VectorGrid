{
  "schema_version": 2,
  "timing_boundary": "headless-output-parity",
  "timing_boundary_note": "Deterministic ta_headless_validate report generation for structural JSON/CSV/XLSX parity plus JSON baseline and validation CSV/JSON semantic checks. Supplemental verification only; not a perf gate.",
  "build_profile": "dev",
  "package": "ta_desktop_demo_app",
  "bin": "ta_headless_validate",
  "outputs": {
    "report_json": "_write_test/headless_reports/vectorgrid_synthetic_headless_current.json",
    "report_csv": "_write_test/headless_reports/vectorgrid_synthetic_headless_current.csv",
    "report_xlsx": "_write_test/headless_reports/vectorgrid_synthetic_headless_current.xlsx",
    "parity_manifest": "_write_test/headless_reports/vectorgrid_synthetic_headless_current.parity_manifest.json"
  },
  "args": [
    "--csv",
    "src-tauri/resources/sample-data/vectorgrid_synthetic_ohlcv.csv",
    "--cross-csv",
    "src-tauri/resources/sample-data/vectorgrid_synthetic_ohlcv.csv",
    "--cross-mode",
    "preserved-finalists",
    "--backend",
    "cpu",
    "--fast-ma",
    "sma",
    "--slow-ma",
    "sma",
    "--fast-period",
    "3:9:3",
    "--slow-period",
    "12:24:6",
    "--optimize-top-k",
    "12",
    "--validate-max-candidates",
    "9",
    "--heatmap-bins",
    "12",
    "--xlsx-max-rows",
    "12",
    "--seed",
    "1",
    "--wf-enable",
    "--wf-window-bars",
    "48",
    "--wf-step-bars",
    "16",
    "--perturb-enable",
    "--perturb-iterations",
    "16",
    "--bootstrap-enable",
    "--bootstrap-sims",
    "64",
    "--cscv-enable",
    "--cscv-slices",
    "8",
    "--cscv-max-combinations",
    "512",
    "--cross-max-datasets",
    "1",
    "--cross-gate-disabled",
    "--cache-dir",
    "_write_test/headless_cache/section19_output_parity"
  ]
}
